# VidSnap 环境变量示例 —— 复制为 .env.local 后填入真实值

# LLM Provider：deepseek（默认）| claude
LLM_PROVIDER=deepseek

# DeepSeek API Key（AI 总结 + 追问）
DEEPSEEK_API_KEY=

# 硅基流动 SenseVoice API Key（云端转写 + BAAI/bge-m3 embedding + 关键帧视觉理解共用）
SENSEVOICE_API_KEY=

# 关键帧视觉理解（可选）：VISION_ENABLED=0 显式关闭；VISION_MODEL 覆盖默认视觉模型
# VISION_ENABLED=
# VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct

# 本地 Whisper 模型：tiny | base | small | medium | large（无 SenseVoice 时降级使用）
WHISPER_MODEL=medium

# 本地转写总预算：含排队、握手、推理及至多一次脚本兜底，默认 10 分钟。
# 可配置 1000—1800000 毫秒；常驻预加载握手另受默认 2 分钟的启动预算限制。
# WHISPER_TIMEOUT_MS=600000
# WHISPER_STARTUP_TIMEOUT_MS=120000

# 访问码门禁（可选）：配置后网站需输入此码才能使用；留空则不启用门禁
ACCESS_CODE=

# 媒体出站的可信上游 HTTP 代理（可选，例如本机代理软件的 HTTP / mixed 端口）。
# 留空时直接连接已校验的公网 IP；不会自动采用系统代理或 HTTP(S)_PROXY / NO_PROXY。
# 只向此固定代理发送已校验公网 IP 的 CONNECT，目标 TLS 仍校验原域名。
MEDIA_UPSTREAM_PROXY=
