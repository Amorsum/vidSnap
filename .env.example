# VidSnap 环境变量示例 —— 复制为 .env.local 后填入真实值

# LLM Provider：deepseek（默认）| claude
LLM_PROVIDER=deepseek

# DeepSeek API Key（AI 总结 + 追问）
DEEPSEEK_API_KEY=

# 硅基流动 SenseVoice API Key（云端转写；同时用于 BAAI/bge-m3 embedding）
SENSEVOICE_API_KEY=

# 本地 Whisper 模型：tiny | base | small | medium | large（无 SenseVoice 时降级使用）
WHISPER_MODEL=medium

# 访问码门禁（可选）：配置后网站需输入此码才能使用；留空则不启用门禁
ACCESS_CODE=
