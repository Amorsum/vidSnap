# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# temporary video/audio files
/tmp

# cookies (contains browser session data)
cookies.txt

# typescript
*.tsbuildinfo
next-env.d.ts

# Python vendor packages
scripts/_vendor/

# TRAE internal
.trae/

# yt-dlp artifacts
--dump-json
*.dump

# 改进方案进度状态文件（update-plan 技能维护，勿提交）
.claude/.plan-state

# Cloudflare 隧道配置（含凭据路径，勿提交；用 cloudflared-config.example.yml 作模板）
cloudflared-config.yml

# Cloudflare 隧道客户端二进制（约 54MB，自行下载，见 README 部署章节）
cloudflared.exe
vidsnap-server.log
vidsnap-tunnel.log
